# PostgreSQL (recommended for production)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=postgresql+psycopg2://mzsource:mzsource@localhost:5432/mzsource

# For quick local testing without installing Postgres, comment the line above
# and uncomment this one instead (creates a file-based SQLite DB):
# DATABASE_URL=sqlite:///./mzsource.db

# JWT
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
BUYER_TOKEN_EXPIRE_MINUTES=43200
ADMIN_TOKEN_EXPIRE_MINUTES=1440

# Seed admin account (created automatically on first run if no admin exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Demo buyer OTP (any OTP works if DEMO_OTP_BYPASS=true, useful before SMS gateway is wired up)
DEMO_OTP_BYPASS=true
DEMO_OTP_CODE=123456
